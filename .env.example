# Copy to .env (the install task does this and generates DEMO_TOKEN). Never commit .env.

# --- AWS ---
AWS_REGION=us-east-1
STACK_NAME=threshold
# Account-wide AWS Budget alert. Leave ALERT_EMAIL empty to skip the budget.
ALERT_EMAIL=
MONTHLY_BUDGET_USD=25
# Optional: subscribe an email to escalation alerts (SNS sends a confirmation email first).
# Empty -> the topic exists but reaches nobody; escalations are still recorded and shown in the UI.
ESCALATION_EMAIL=

# --- App ---
# Demo auth only: one shared bearer token for non-webhook routes. Not production auth.
DEMO_TOKEN=replace-me
# Signs test-harness webhooks (our own key, never Ring's). The source label is derived from which key verifies.
HARNESS_HMAC_KEY=replace-me
APP_ENV=local
STORE_BACKEND=memory
# inline | thread (local) | lambda (AWS, set by template.yaml)
DISPATCH_MODE=thread
RESIDENT_LANGUAGE=en-IN
PRECOMPUTED_TRANSCRIPTS=false

# --- Bedrock (verified in docs/PHASE0_AWS_CHECKS.md) ---
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_TRANSLATE_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Ring Partner API (optional; the demo runs without these) ---
# Mode A: short-lived Playground access token (~30 min)
RING_ACCESS_TOKEN=
# Mode B: OAuth refresh token + app credentials (do not set both modes)
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# HMAC Signature Key, used to verify X-Signature on webhooks
RING_HMAC_KEY=
